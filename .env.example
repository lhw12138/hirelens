DATABASE_URL=postgres://hirelens:hirelens@localhost:5432/hirelens
AUTH_SECRET=replace-with-at-least-32-random-characters
HR_ADMIN_EMAIL=admin@hirelens.local
HR_DAILY_AI_LIMIT=50
HR_ADMIN_PASSWORD=hirelens-demo
DEMO_AUTH_BYPASS=false
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_CONVERSATION=qwen-plus
MODEL_INTERVIEW=qwen-plus
MODEL_REVIEW=qwen-max
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=qwen3-rerank
# Local multilingual E5. Start npm run rag:serve before scoring.
# keyword is an explicit comparison baseline, never an automatic fallback.
RAG_MODE=hybrid
RAG_LOCAL_URL=http://127.0.0.1:3041
RAG_LOCAL_TOKEN=hirelens-local-embeddings
RAG_MODEL_CACHE=.cache/e5
RAG_MODEL_HOST=https://modelscope.cn/
RAG_OFFLINE=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hirelens
S3_ACCESS_KEY=hirelens
S3_SECRET_KEY=hirelens-secret
S3_FORCE_PATH_STYLE=true
CANDIDATE_LINK_SECRET=replace-with-at-least-32-random-characters
# Encrypts each user's SMTP authorization code and candidate email.
# Keep this value stable; changing it makes saved mail settings unreadable.
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-secret
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
