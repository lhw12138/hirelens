NODE_ENV=production
DATABASE_URL=postgres://<db-user>:<db-password>@<rds-private-host>:5432/hirelens?sslmode=require
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=<new-production-model-key>
MODEL_CONVERSATION=deepseek-chat
MODEL_INTERVIEW=deepseek-chat
MODEL_REVIEW=deepseek-chat
RAG_MODE=hybrid
RAG_LOCAL_URL=<rag-sae-private-url>
RAG_LOCAL_TOKEN=<same-rag-service-token>
S3_ENDPOINT=https://oss-cn-hongkong-internal.aliyuncs.com
S3_REGION=cn-hongkong
S3_BUCKET=<private-oss-bucket>
S3_ACCESS_KEY=<ram-access-key-id>
S3_SECRET_KEY=<ram-access-key-secret>
S3_FORCE_PATH_STYLE=false
S3_SSE=AES256
CANDIDATE_LINK_SECRET=<same-candidate-link-secret>
SETTINGS_ENCRYPTION_KEY=<same-stable-encryption-secret>
