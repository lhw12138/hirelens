FROM node:22-bookworm-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY scripts/local-embeddings.mjs scripts/local-embeddings.mjs
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 rag && mkdir -p /models/e5 && chown -R rag:nodejs /app /models/e5
ENV NODE_ENV=production RAG_LOCAL_HOST=0.0.0.0 RAG_MODEL_CACHE=/models/e5
USER rag
EXPOSE 3041
CMD ["node","scripts/local-embeddings.mjs"]
